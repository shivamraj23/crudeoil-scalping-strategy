# Streamlit Community Cloud: Settings > Secrets, paste the block below (then delete this file).
# Local development keeps using the .env file instead, so .streamlit/secrets.toml is optional
# and must never be committed.
#
# TOTP secret = the base32 string from your Dhan "Authenticator" setup (what you type into
# Google Authenticator, with the otpauth:// prefix removed).

DHAN_CLIENT_ID = "1000000001"
DHAN_PIN = "123456"
DHAN_TOTP_SECRET = "ABCDEFGHIJKLMNOP"
DISCORD_WEBHOOK_SUPERTREND_FNO_STOCKS = "https://discord.com/api/webhooks/xxxx/xxxx"

# Optional: paste a Dhan access token and the TOTP login is skipped (Dhan allows only
# 1 new token every 2 minutes, so a token is more reliable on a cloud host).
# DHAN_ACCESS_TOKEN = "eyJ0eXAiOiJKV1QiLCJhbGc..."